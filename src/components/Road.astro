---
/* Project the published CalcRoad surface. Vertical exaggeration reveals the saddle. */
const elevation = (x: number, y: number) =>
  0.00025 * x * x + 0.07 * (1 - (y * y) / 12.25);
const project = (x: number, y: number, z: number) => [
  264 + 8.0 * x + 15 * y,
  162 - 1.65 * x + 8.8 * y - 575 * z,
];
const point = (x: number, y: number, z = elevation(x, y)) =>
  project(x, y, z)
    .map((v) => v.toFixed(1))
    .join(",");
const range = (n: number) => Array.from({ length: n + 1 }, (_, i) => i);
const section = (y: number) =>
  range(64)
    .map((i) => point(-20 + (40 * i) / 64, y))
    .join(" ");
const face =
  section(-3.5) +
  " " +
  range(20)
    .map((i) => point(20, -3.5 + (7 * i) / 20))
    .join(" ") +
  " " +
  range(64)
    .map((i) => point(20 - (40 * i) / 64, 3.5))
    .join(" ") +
  " " +
  range(20)
    .map((i) => point(-20, 3.5 - (7 * i) / 20))
    .join(" ");
---

<svg
  class="road-svg"
  viewBox="0 -7 528 263"
  role="img"
  aria-label="Wireframe of the CalcRoad elevation model, with a dip along its length and a crown across its width. Vertical scale exaggerated."
>
  <g fill="none" stroke="#879283" stroke-width=".65">
    {range(8).map((i) => (
      <polyline
        points={[
          point(-20 + i * 5, -3.5, -0.036),
          point(-20 + i * 5, 3.5, -0.036),
        ].join(" ")}
      />
    ))}
    {range(4).map((i) => (
      <polyline
        points={[
          point(-20, -3.5 + i * 1.75, -0.036),
          point(20, -3.5 + i * 1.75, -0.036),
        ].join(" ")}
      />
    ))}
    {[-20, 20].flatMap((x) =>
      [-3.5, 3.5].map((y) => (
        <polyline
          stroke-dasharray="2 3"
          points={point(x, y) + " " + point(x, y, -0.036)}
        />
      )),
    )}
  </g>
  <polygon points={face} fill="#d7ddc9" stroke="#283e32" stroke-width="1" />
  <g fill="none" stroke="#2a4030" stroke-linejoin="round">
    {range(32).map((i) => (
      <polyline
        points={section(-3.5 + (7 * i) / 32)}
        stroke-width={i % 4 === 0 ? 1.1 : 0.58}
      />
    ))}
    {range(56).map((i) => (
      <polyline
        points={range(20)
          .map((j) => point(-20 + (40 * i) / 56, -3.5 + (7 * j) / 20))
          .join(" ")}
        stroke-width={i % 7 === 0 ? 1 : 0.57}
      />
    ))}
  </g>
  <polyline
    fill="none"
    stroke="#9e4028"
    stroke-width="1.8"
    points={section(0)}
  />
  <g
    fill="#424e41"
    font-size="11"
    font-style="italic"
    font-family="Georgia,serif"
  >
    <text x="325" y="228">
      x
    </text>
    <text x="93" y="208">
      y
    </text>
  </g>
</svg>
